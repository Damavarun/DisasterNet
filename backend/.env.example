# Copy to backend/.env. Never commit .env or your data directory.
HOST=0.0.0.0
PORT=3001
P2P_PORT=9000
NODE_NAME=Varun
NETWORK_NAME=disasternet-local
DATA_DIR=./data
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=disasternet
MYSQL_PASSWORD=change-this-locally
MYSQL_DATABASE=disasternet
# Optional manual peers, comma-separated libp2p multiaddresses.
BOOTSTRAP_PEERS=
# Local session PIN. Set a strong value before exposing to other LAN users.
ACCESS_PIN=change-this-local-pin
# Allowed browser origins beyond localhost and this computer's LAN IPs.
ALLOWED_ORIGINS=
